# MediaHunt environment variables
# Copy to .env and edit as needed: cp .env.example .env

# Server port exposed by the container (default 5556)
PORT=5556

# OpenSubtitles REST API key (free, get yours at https://www.opensubtitles.com/consumers)
# Can also be set via the Settings page after starting the app.
OPENSUBTITLES_API_KEY=

# CORS origins (comma-separated). "*" allows any origin.
CORS_ORIGINS=*

# Mongo database name used inside the bundled mongo container
DB_NAME=mediahunt
